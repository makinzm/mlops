# Kaggle 認証は ~/.kaggle/access_token ファイルを使用してください。
# 詳細は docs/manual/kaggle-dataset-download.md を参照。

# 将来的に他の認証情報をここに追加する場合:
# SOME_OTHER_TOKEN=your-token-here

# GCP 設定（詳細: docs/manual/1000_gcp-initial-setup.md）
GCP_PROJECT=mlops-titanic-123456               # 【必須】GCP プロジェクト ID
GCP_BILLING_ACCOUNT=012345-ABCDEF-789012       # 【必須】請求アカウント ID
GCP_BUDGET_ALERT_EMAIL=your@email.com          # 【必須】予算アラート通知先
GCP_REGION=asia-northeast1                     # リージョン（デフォルト: asia-northeast1）
# GCP_BUCKET_NAME=my-custom-bucket             # 未設定なら {GCP_PROJECT}-mlops-staging
# GCP_BUDGET_AMOUNT=10                         # 月間予算上限 USD（デフォルト: 10）
# GCP_BUDGET_ACTION=warn                       # warn: 通知のみ / stop: ジョブ自動停止
