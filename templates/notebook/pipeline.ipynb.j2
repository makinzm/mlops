   "source": [
    "# セル 1: 環境セットアップ（編集不要）\n",
    "import importlib.metadata\n",
    "import os\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "# 未インストールのパッケージだけを pip install する。\n",
    "# すでにインストール済みの場合はスキップ。\n",
    "# メジャーバージョンが異なる場合は WARNING を出すがインストールはしない。\n",
    "def _smart_install(req_path: str) -> None:\n",
    "    with open(req_path) as f:\n",
    "        lines = [l.strip() for l in f if l.strip() and not l.startswith('#')]\n",
    "    to_install = []\n",
    "    for line in lines:\n",
    "        m = re.match(r'^([A-Za-z0-9_\\-\\.]+)==(.+)$', line)\n",
    "        if m:\n",
    "            pkg, req_ver = m.group(1), m.group(2)\n",
    "            try:\n",
    "                inst_ver = importlib.metadata.version(pkg)\n",
    "                if inst_ver.split('.')[0] != req_ver.split('.')[0]:\n",
    "                    print(f'WARNING: {pkg} installed={inst_ver} required={req_ver} (major version differs, skipping)')\n",
    "            except importlib.metadata.PackageNotFoundError:\n",
    "                to_install.append(line)\n",
    "        else:\n",
    "            to_install.append(line)\n",
    "    if to_install:\n",
    "        subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q'] + to_install)\n",
    "\n",
    "_smart_install('/kaggle/input/{{ src_dataset }}/requirements.txt')\n",
    "\n",
    "# Kaggle では src.zip の中身が /kaggle/input/{{ src_dataset }}/ に直接展開される\n",
    "# (例: /kaggle/input/{{ src_dataset }}/domain/, /infrastructure/, ...)\n",
    "# /kaggle/working/src -> /kaggle/input/{{ src_dataset }}/ のシンボリックリンクを張ることで\n",
    "# `from src.xxx import ...` を自然に動かす\n",
    "_SRC_DATASET_PATH = '/kaggle/input/{{ src_dataset }}'\n",
    "_SRC_LINK = '/kaggle/working/src'\n",
    "if not os.path.exists(_SRC_LINK):\n",
    "    os.symlink(_SRC_DATASET_PATH, _SRC_LINK)\n",
    "sys.path.insert(0, '/kaggle/working')"
   ]
  },
  {
   "cell_type": "code",
