   "source": [
    "# セル 1: 環境セットアップ（編集不要）\n",
    "# mlops-pipeline-src データセットからソースコードを読み込む\n",
    "import sys\n",
    "\n",
    "# Notebook 環境でのパッケージインストール\n",
    "!pip install -q polars lightgbm hydra-core omegaconf pyyaml python-dotenv\n",
    "\n",
    "sys.path.insert(0, \"/kaggle/input/{{ src_dataset }}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# セル 2: 設定上書き（competition slug やパスを変える場合はここを編集する）\n",
    "# KaggleEnvironment が KAGGLE_KERNEL_RUN_TYPE 環境変数を検出して\n",
    "# /kaggle/input / /kaggle/working に自動解決する。\n",
    "# スラッグを変えたい場合のみ以下を編集すること。\n",
    "COMPETITION_SLUG = \"{{ competition }}\"\n",
    "# input:  /kaggle/input/{COMPETITION_SLUG}/\n",
    "# output: /kaggle/working/"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# セル 3: パイプライン実行（編集不要）\n",
    "# KaggleEnvironment がパスを解決し、前処理 → 学習 → 推論を順次実行する。\n",
    "# 推論結果は /kaggle/working/inference/.../submission.csv に出力される。\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "from omegaconf import OmegaConf\n",
    "\n",
    "from src.infrastructure.kaggle.environment import KaggleEnvironment\n",
    "from src.usecase.pipeline.pipeline import PipelineUseCase\n",
    "\n",
    "env = KaggleEnvironment()\n",
    "input_root = KaggleEnvironment.resolve_input_root(COMPETITION_SLUG)\n",
    "output_root = KaggleEnvironment.resolve_output_root()\n",
    "\n",
    "# パイプライン設定をパスに合わせて構築\n",
    "pipeline_cfg = OmegaConf.create({\n",
    "    \"usecase\": \"pipeline\",\n",
    "    \"job_id\": f\"{COMPETITION_SLUG}_pipeline\",\n",
    "    \"steps\": [\n",
    "        {\n",
    "            \"usecase\": \"preprocess\",\n",
    "            \"job_id\": f\"{COMPETITION_SLUG}_preprocess\",\n",
    "            \"inputs\": [\n",
    "                {\"id\": \"raw_train\", \"path\": str(input_root / \"train.csv\"), \"format\": \"csv\"},\n",
    "                {\"id\": \"raw_test\",  \"path\": str(input_root / \"test.csv\"),  \"format\": \"csv\"},\n",
    "            ],\n",
    "            \"output_dir\": str(output_root / \"processed\"),\n",
    "        },\n",
    "        {\n",
    "            \"usecase\": \"train\",\n",
    "            \"job_id\": f\"{COMPETITION_SLUG}_lgbm\",\n",
    "            \"output_dir\": str(output_root / \"models\"),\n",
    "        },\n",
    "        {\n",
    "            \"usecase\": \"inference\",\n",
    "            \"job_id\": f\"{COMPETITION_SLUG}_inference\",\n",
    "            \"test_path\": str(output_root / \"processed\" / f\"{COMPETITION_SLUG}_preprocess\" / \"latest\" / \"test_out\" / \"test.parquet\"),\n",
    "            \"output_dir\": str(output_root / \"inference\"),\n",
    "        },\n",
    "    ],\n",
    "})\n",
    "\n",
    "print(f\"[INFO] input_root  : {input_root}\")\n",
    "print(f\"[INFO] output_root : {output_root}\")\n",
    "print(\"[INFO] Starting pipeline...\")\n",
    "\n",
    "# NOTE: Notebook 内では Hydra を使わず DI を直接行う\n",
    "from src.infrastructure.executor.factory import ExecutorFactory\n",
    "from src.infrastructure.preprocessor.cv_splitter import CVSplitter\n",
    "from src.infrastructure.preprocessor.input_loader import InputLoader\n",
    "from src.infrastructure.preprocessor.visualizer import PipelineVisualizer\n",
    "from src.infrastructure.repository.git import GitRepositoryImpl\n",
    "from src.infrastructure.trainer.lgbm_trainer import LightGBMTrainer\n",
    "from src.infrastructure.inference.lgbm_inferencer import LightGBMInferencer\n",
    "from src.usecase.preprocessing.pipeline_loader import load_pipeline_cfgs\n",
    "from src.usecase.preprocessing.preprocess import PreprocessUseCase\n",
    "from src.usecase.training.train import TrainUseCase\n",
    "from src.usecase.training.trainer_loader import load_trainer_cfgs\n",
    "from src.usecase.inference.inference import InferenceUseCase\n",
    "from src.usecase.inference.inference_loader import load_inference_cfgs\n",
    "\n",
    "git_repo = GitRepositoryImpl()\n",
    "executor, _ = ExecutorFactory.build_with_fallback(\"local\")\n",
    "\n",
    "for step in pipeline_cfg.steps:\n",
    "    step_usecase = step.usecase\n",
    "    print(f\"[INFO] Running step: {step_usecase}\")\n",
    "    if step_usecase == \"preprocess\":\n",
    "        PreprocessUseCase(\n",
    "            step,\n",
    "            executor=executor,\n",
    "            git_repo=git_repo,\n",
    "            input_loader=InputLoader(),\n",
    "            cv_splitter=CVSplitter(),\n",
    "            visualizer=PipelineVisualizer(),\n",
    "        ).execute()\n",
    "    elif step_usecase == \"train\":\n",
    "        TrainUseCase(step, trainer=LightGBMTrainer(step), git_repo=git_repo).execute()\n",
    "    elif step_usecase == \"inference\":\n",
    "        submission_path = InferenceUseCase(\n",
    "            inferencer=LightGBMInferencer(), git_repo=git_repo\n",
    "        ).run(step)\n",
    "        print(f\"[INFO] submission: {submission_path}\")\n",
    "\n",
    "print(\"[INFO] Pipeline complete!\")"
   ]
  }
 ]
}
