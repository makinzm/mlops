   "source": [
    "# セル 1: 環境セットアップ（編集不要）\n",
    "# mlops-pipeline-src データセットからソースコードを読み込む\n",
    "import sys\n",
    "import types\n",
    "\n",
    "# requirements.txt からパッケージをインストール（uv export で自動生成済み）\n",
    "!pip install -q -r /kaggle/input/{{ src_dataset }}/requirements.txt\n",
    "\n",
    "# Kaggle では src.zip の中身が /kaggle/input/{{ src_dataset }}/ に直接展開される\n",
    "# （例: /kaggle/input/{{ src_dataset }}/domain/, /infrastructure/, ...）\n",
    "# `from src.xxx import ...` が動くよう src を名前空間モジュールとして登録する\n",
    "_SRC_PATH = \"/kaggle/input/{{ src_dataset }}\"\n",
    "_src_mod = types.ModuleType(\"src\")\n",
    "_src_mod.__path__ = [_SRC_PATH]  # type: ignore[assignment]\n",
    "_src_mod.__package__ = \"src\"\n",
    "sys.modules[\"src\"] = _src_mod\n",
    "sys.path.insert(0, _SRC_PATH)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# セル 2: 設定（ここだけ編集する）\n",
    "COMPETITION_SLUG = \"{{ competition }}\"\n",
    "RECIPE = \"base\"   # conf/recipe/ 以下のファイル名\n",
    "\n",
    "# Kaggle Notebook 上での設定上書き（不要なら空のまま）\n",
    "# 例: {\"lgbm.num_leaves\": 64, \"preprocess.cv\": False}\n",
    "OVERRIDES: dict = {}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# セル 3: パイプライン実行（編集不要）\n",
    "from src.infrastructure.kaggle.notebook_runner import NotebookPipelineRunner\n",
    "\n",
    "runner = NotebookPipelineRunner(\n",
    "    competition_slug=COMPETITION_SLUG,\n",
    "    recipe=RECIPE,\n",
    "    overrides=OVERRIDES,\n",
    ")\n",
    "submission_path = runner.run()\n",
    "print(f\"[INFO] submission: {submission_path}\")"
   ]
  }
