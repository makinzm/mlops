   "source": [
    "# セル 1: 環境セットアップ（編集不要）\n",
    "import os\n",
    "import sys\n",
    "\n",
    "# Kaggle のデータセットパスを自動検出する\n",
    "# 新形式: /kaggle/input/datasets/{owner}/{slug}/\n",
    "# 旧形式: /kaggle/input/{slug}/\n",
    "_DATASET_SLUG = '{{ src_dataset }}'\n",
    "_KAGGLE_USERNAME = '{{ kaggle_username }}'\n",
    "_NEW_PATH = f'/kaggle/input/datasets/{_KAGGLE_USERNAME}/{_DATASET_SLUG}'\n",
    "_OLD_PATH = f'/kaggle/input/{_DATASET_SLUG}'\n",
    "_DATASET_ROOT = _NEW_PATH if os.path.exists(_NEW_PATH) else _OLD_PATH\n",
    "print(f'Dataset root: {_DATASET_ROOT}')\n",
    {% if enable_internet %}
    "\n",
    "import importlib.metadata\n",
    "import re\n",
    "import subprocess\n",
    "\n",
    "def _smart_install(req_path: str) -> None:\n",
    "    with open(req_path) as f:\n",
    "        lines = [l.strip() for l in f if l.strip() and not l.strip().startswith('#')]\n",
    "    to_install = []\n",
    "    for line in lines:\n",
    "        m = re.match(r'^([A-Za-z0-9_\\-\\.]+)==(.+)$', line)\n",
    "        if m:\n",
    "            pkg, req_ver = m.group(1), m.group(2)\n",
    "            try:\n",
    "                inst_ver = importlib.metadata.version(pkg)\n",
    "                if inst_ver.split('.')[0] != req_ver.split('.')[0]:\n",
    "                    print(f'WARNING: {pkg} installed={inst_ver} required={req_ver} (major version differs, skipping)')\n",
    "            except importlib.metadata.PackageNotFoundError:\n",
    "                to_install.append(line)\n",
    "        else:\n",
    "            to_install.append(line)\n",
    "    if to_install:\n",
    "        subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q'] + to_install)\n",
    "\n",
    "_smart_install(f'{_DATASET_ROOT}/requirements.txt')\n",
    {% endif %}
    "\n",
    "# /kaggle/working/src -> {_DATASET_ROOT}/src のシンボリックリンクで\n",
    "# `from src.xxx import ...` を自然に動かす\n",
    "_SRC_DATASET_PATH = f'{_DATASET_ROOT}/src'\n",
    "_SRC_LINK = '/kaggle/working/src'\n",
    "if os.path.lexists(_SRC_LINK):\n",
    "    os.remove(_SRC_LINK)\n",
    "os.symlink(_SRC_DATASET_PATH, _SRC_LINK)\n",
    "sys.path.insert(0, '/kaggle/working')\n",
    "\n",
    "# conf のシンボリックリンクも張る（NotebookPipelineRunner が参照する）\n",
    "_CONF_LINK = '/kaggle/working/conf'\n",
    "if os.path.lexists(_CONF_LINK):\n",
    "    os.remove(_CONF_LINK)\n",
    "os.symlink(f'{_DATASET_ROOT}/conf', _CONF_LINK)\n",
    "\n",
    "# 追加 Dataset（モデル重み等）のシンボリックリンクを張る\n",
    "# _patch_paths が models パスを /kaggle/working/ 以下に変換するため、\n",
    "# 外部 Dataset の中身を /kaggle/working/ 以下に配置する必要がある\n",
    {% for ds in extra_datasets %}
    "_EXTRA_DS = '{{ ds }}'\n",
    "_EXTRA_NEW = f'/kaggle/input/datasets/{_KAGGLE_USERNAME}/{_EXTRA_DS}'\n",
    "_EXTRA_OLD = f'/kaggle/input/{_EXTRA_DS}'\n",
    "_EXTRA_ROOT = _EXTRA_NEW if os.path.exists(_EXTRA_NEW) else _EXTRA_OLD\n",
    "if os.path.exists(_EXTRA_ROOT):\n",
    "    # Dataset の中身を /kaggle/working/ 以下に展開（シンボリックリンク）\n",
    "    for _item in os.listdir(_EXTRA_ROOT):\n",
    "        _src = os.path.join(_EXTRA_ROOT, _item)\n",
    "        _dst = os.path.join('/kaggle/working', _item)\n",
    "        if not os.path.lexists(_dst):\n",
    "            os.symlink(_src, _dst)\n",
    "    print(f'Extra dataset linked: {_EXTRA_ROOT} -> /kaggle/working/')\n",
    {% endfor %}
    "print('Setup complete')"
   ]
  },
  {
