# Data and report directories are managed by per-directory .gitignore files
# created at runtime (setup_data_dir / analyzer._setup_output_gitignore).
# Only metadata (*.yaml, *.md, *.html) is kept; images and parquet are excluded.

# Hydra outputs (run logs, hydra config snapshots)
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
.env

# IDE
.idea/
.vscode/

# MLflow
mlruns/

# Jupyter
.ipynb_checkpoints/

# Pytest
.coverage
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml


# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Staging directory for Kaggle Dataset uploads (auto-created by create/update_source_dataset)
.staging/

# Generated Kaggle Notebooks (reproducible from push_notebook + template + conf/)
notebooks/
