# Data (raw/processed datasets - excluded from version control)
# data/ だと親ごと除外され子の !.gitkeep が効かないため data/** を使う
data/**
!data/**/
!data/**/.gitkeep
!data/**/.gitignore

# EDA reports (auto-generated outputs - same pattern as data/)
competition/**
!competition/**/
!competition/**/.gitkeep
!competition/**/README.md

outputs/

# Python
__pycache__/
*.py[cod]
.venv/
.env

# IDE
.idea/
.vscode/

# MLflow
mlruns/

# Jupyter
.ipynb_checkpoints/

# Pytest
.coverage
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml


# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml
